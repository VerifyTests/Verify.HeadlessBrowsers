<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="15.1.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="30.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.190" />
    <PackageVersion Include="PuppeteerSharp" Version="25.18.1" />
    <PackageVersion Include="Sbom" Version="1.0.0" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.53.0" />
    <PackageVersion Include="Selenium.WebDriver.ChromeDriver" Version="158.0.8127.3600" />
    <PackageVersion Include="Verify" Version="33.7.2" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.ImageMagick" Version="4.1.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.2" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <!-- explicit to avoid a cve -->
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="DiffEngine" Version="21.2.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
  </ItemGroup>
</Project>
