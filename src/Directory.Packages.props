<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.17.1" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.4" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.181" />
    <PackageVersion Include="PuppeteerSharp" Version="25.12.0" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.49.0" />
    <PackageVersion Include="Selenium.WebDriver.ChromeDriver" Version="154.0.8037.5700" />
    <PackageVersion Include="Verify" Version="33.1.4" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.ImageMagick" Version="3.10.0" />
    <PackageVersion Include="Verify.NUnit" Version="33.1.4" />
    <!-- explicit to avoid a cve -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="Argon" Version="0.37.0" />
    <PackageVersion Include="DiffEngine" Version="20.5.1" />
    <PackageVersion Include="EmptyFiles" Version="8.19.0" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.0" />
  </ItemGroup>
</Project>
