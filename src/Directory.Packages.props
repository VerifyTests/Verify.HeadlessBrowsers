<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="15.1.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="29.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.188" />
    <PackageVersion Include="PuppeteerSharp" Version="25.15.0" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.52.0" />
    <PackageVersion Include="Selenium.WebDriver.ChromeDriver" Version="157.0.8103.5000" />
    <PackageVersion Include="Verify" Version="33.3.4" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.ImageMagick" Version="4.1.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
    <!-- explicit to avoid a cve -->
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="DiffEngine" Version="20.9.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
  </ItemGroup>
</Project>
